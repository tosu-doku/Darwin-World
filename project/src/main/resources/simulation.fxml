<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="agh.ics.oop.presenter.SimulationPresenter"
            prefHeight="600.0" prefWidth="800.0">

    <left>
        <VBox spacing="10" prefWidth="200" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Stats" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Label fx:id="dayCountLabel" text="Day: 0"/>
            <Label fx:id="animalCountLabel" text="Animals: 0"/>
            <Label fx:id="grassCountLabel" text="Grass: 0"/>
            <Label fx:id="freeFieldsLabel" text="Vacant cells: 0"/>
            <Label fx:id="avgEnergyLabel" text="Avg Energy: 0"/>
            <Label fx:id="avgLifespanLabel" text="Avg Lifespan: 0"/>
            <Label fx:id="avgChildrenLabel" text="Avg Children Amount: 0"/>
            <Separator />
            <Label text="Choose a statistic:" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="statSelector" maxWidth="Infinity" />
            <LineChart fx:id="populationChart" animated="false" createSymbols="false" style="-fx-padding: 0 20 0 0;">
                <xAxis>
                    <NumberAxis label="Day" side="BOTTOM" animated="false" />
                </xAxis>
                <yAxis>
                    <NumberAxis side="LEFT" animated="false" />
                </yAxis>
            </LineChart>
            <Separator />
            <Button maxWidth="Infinity" fx:id="pauseButton" text="Pause" onAction="#onPauseButtonClicked" />
            <Button maxWidth="Infinity" fx:id="stopButton" text="Stop" onAction="#onStopButtonClicked" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true">
            <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: #eeeeee;">
                <Canvas fx:id="mapGrid" width="500" height="500" />
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>